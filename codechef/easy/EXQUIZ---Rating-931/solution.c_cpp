#include<bits/stdc++.h>
using namespace std;
using ll = long long;
using vi = vector < int > ;
using vll = vector < ll > ;
using pii = pair < int, int > ;

#define pb push_back
#define all(x)(x).begin(), (x).end()
#define sz(x)(int)(x).size()
#define endl '\n'

void fahhh() {
    int n, s;
    cin >> n >> s;
    if (s % 4 == 0 && s / 4 <= n)
        cout << s / 4 << endl;
    else if (s % 4 == 1 && (s + 15) / 4 <= n)
        cout << (s + 15) / 4 << endl;
    else if (s % 4 == 2 && (s + 10) / 4 <= n)
        cout << (s + 10) / 4 << endl;
    else if (s % 4 == 3 && (s + 5) / 4 <= n)
        cout << (s + 5) / 4 << endl;
    else
        cout << -1 << endl;

}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t = 1;
    cin >> t;
    while (t--) {
        fahhh();
    }

    return 0;
}