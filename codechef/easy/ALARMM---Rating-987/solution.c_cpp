
#include <bits/stdc++.h>
using namespace std;

int main() {
    int test_cases;
    cin >> test_cases;

    while (test_cases--) {
        int n, k;
        cin >> n >> k;

        string s;
        cin >> s;

        int alarm_count = 0;

        for (int i = 0; i < n; i++) {
            if (s[i] == '1') {
                alarm_count++;
                i = min(n - 1, i + k);
            }
        }

        cout << alarm_count << '\n';
    }

    return 0;
}