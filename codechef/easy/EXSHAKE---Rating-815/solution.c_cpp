#include<bits/stdc++.h>


using namespace std;
using ll = long long;
using vi = vector<int>;
using vll = vector<ll>;
using pii = pair<int, int>;

#define pb push_back
#define all(x) (x).begin(), (x).end()
#define sz(x) (int)(x).size()
#define endl '\n'

void fahhh() {
int n,m;
cin>>n>>m;
int ans=0;
vi v(n);
for(int i=0;i<n;i++)
{cin>>v[i];
    
}
     sort(all(v));
     for(int i=0;i<n;i++)
     {if((v[i]*(v[i]-1))/2 <=m)
         {v[i+1]+= v[i];
         ans++;}
         else
         break;
     }
     cout<<ans<<endl;
    
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t = 1;
   cin >> t;
    while (t--) {
        fahhh();
    }
    
    return 0;
}
