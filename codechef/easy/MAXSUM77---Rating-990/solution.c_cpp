#include<bits/stdc++.h>
using namespace std;

#define ll long long
#define endl '\n'
#define ll long long
#define endl '\n'
#define input(v, n)             \
    for (int i = 0; i < n; i++) \
        cin >> v[i];
#define output(v)         \
    for (auto x : v)      \
    {                     \
        cout << x << " "; \
    }                     \
    cout << endl;


int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);


    int t; cin >> t;

    while(t--){
        int n, k;
        cin >> n >> k;
        int arr[n];
        input(arr, n);

        int sz = n-k;
        int ans = 0;

        for(int i=0; i<n; i++){
            int sum = 0, cnt = 0;
            for(int j=i; j<n; j++){
                if(cnt == sz) break;
                sum += arr[j];
                cnt++;
            }
            ans = max(ans, sum);
        }

        cout << ans << endl;

    }

    return 0;
}