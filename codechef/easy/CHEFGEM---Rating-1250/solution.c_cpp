#include <bits/stdc++.h>
using namespace std;

void solve() {
    int k, n;
    cin >> k >> n;
    priority_queue<int, vector<int>, greater<int>> pq;
    for(int i = 0; i < n; i++) {
        int ni;
        cin >> ni;
        if(i < k) {
            pq.push(ni);
        }
        else {
            if(pq.top() < ni) {
                pq.pop();
                pq.push(ni);
            }
        }
        if(i < k - 1) {
            cout << -1 << " ";
        }
        else {
            cout << pq.top() << " ";
        }
    }
    cout << endl;
}

int main() {
    int t;
    cin >> t;
    while(t--) {
        solve();
    }
	return 0;
}