#include <bits/stdc++.h>
using namespace std;

int main() {
	 int N, M;
    cin >> N >> M;

    unordered_map<long long, int> freqA, freqB;

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            long long x;
            cin >> x;
            freqA[x]++;
        }
    }

    for (int i = 0; i < M; i++) {
        for (int j = 0; j < M; j++) {
            long long x;
            cin >> x;
            freqB[x]++;
        }
    }

    for (auto it : freqB) {
        long long value = it.first;
        int required = it.second;

        if (freqA[value] < required) {
            cout << "FALSE";
            return 0;
        }
    }

    cout << "TRUE";

    return 0;

}