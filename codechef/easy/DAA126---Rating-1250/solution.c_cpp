#include <bits/stdc++.h>
using namespace std;
int main() {
    int n,m;
    cin>>n>>m;
    vector<tuple<int,int,long long>> edges;
    for(int i=0;i<m;i++){
        int u,v;
        long long w;
        cin>>u>>v>>w;
        edges.push_back({u,v,w});
    }
    vector<long long> dis(n+1,LLONG_MAX);
    dis[1]=0;
    for(int i=0;i<n;i++){
        for(auto[u,v,w]:edges){
            if(dis[u]!=LLONG_MAX && dis[u]+w<dis[v]){
                dis[v]=dis[u]+w;
            }
        }
    }
    for(int i=1;i<n+1;i++){
        cout<<dis[i]<<" ";
    }
}