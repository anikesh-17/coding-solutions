#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>a(n);
        for(int i=0;i<n;i++)
            cin>>a[i];
        int oddcnt=0;
        for(int i=0;i<n;i++)
            if(a[i]&1)
                oddcnt++;
        if(oddcnt == 0 || oddcnt%2==0)
            cout<<n<<endl;
        else
        {
            int i=0, j=n-1;
            int cnt=0;
            while(cnt<oddcnt)
            {
                if(a[i]&1)
                    cnt++;
                i++;
            }
            i--;
            cnt=0;
            while(cnt<oddcnt)
            {
                if(a[j]&1)
                    cnt++;
                j--;
            }
            j++;
            cout<<max(i, n-j-1)<<endl;
        }
    }
}