#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--)
    {
        int n,ans=0;
        cin>>n;
        string s;
        cin>>s;
        for(int i=1;i<n;i++)
        {
            int a = s[i]-'0';
            int b = s[i-1]-'0';
            int num = b*10 + a;
            if(num%4==0)
                ans++;
        }
        int a = s[n-1]-'0';
        int b = s[0]-'0';
        int num = a*10 + b;
        if(num%4==0)
            ans++;
        cout<<ans<<endl;
    }
}