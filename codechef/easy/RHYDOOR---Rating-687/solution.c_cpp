#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int T;
	cin>>T;
	while(T--){
	    int N;
	    cin>>N;
	    string S;
	    cin>>S;
	    
	    int opens = 0;
	    int streak = 0;
	    char prev = '#';
	    
	    for(int i=0;i<N;i++){
	        if(S[i]==prev){
	            streak++;
	        }else{
	            streak = 1;
	            prev = S[i];
	        }
	        if(streak==3){
	            opens++;
	            streak = 0;
	        }
	    }
	    cout<<opens<<endl;
	}
}