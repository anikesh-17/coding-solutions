#include <bits/stdc++.h>
using namespace std;
#define ll long long

class Anikesh{
public:
    Anikesh(){
        output();
    }
private:
    void output(){
        int t;
        cin>>t;
        while(t--){
            int n;
            cin>>n;
            vector<ll> vec(n);
            for (int i = 0; i < n; i++) {
                cin>>vec[i];
            }
            cout << drop(vec, n) << endl;
        }
    }
    ll drop(vector<ll> vec, int n){
        sort(vec.begin(), vec.end());
        // int secLarg = vec[n-2];
        // if(vec[n-1] == vec[n-2]){
        //     secLarg = vec[n-3];
        // }
        // if(vec[n-2] != vec[n-1]){
        //     vec[n-2] *= 2;
        // }
        // else{
        //     vec[n-3] *= 2;
        // }
        
        ll sum = accumulate(vec.begin(), vec.end(), 0LL);
        ll most = *max_element(vec.begin(), vec.end());
        ll s1 = sum - most;
        ll s2 = 0;
        ll nsm = 0;
        ll nmst = 0;
        for (int i = 0; i < n; i++) {
            nsm = sum + vec[i];
            nmst = max(most, 2*vec[i]);
            s2 = nsm - nmst;
            s1 = max(s1,s2);
        }
        return s1;
    }
};

int main() {
	// your code goes here
	Anikesh obj;
	return 0;

}
