#include <bits/stdc++.h>
using namespace std;

class Anikesh{
 public:
    Anikesh(){
        output();
    }
private:
    void output(){
        int t;
        cin>>t;
        while(t--){
            int s_len, l_len;
            cin>>s_len >> l_len;
            string s, l;
            cin>>s>>l;
            cout << freqDetermination(s_len, l_len, s, l) << endl;
        }
    }
    int freqDetermination(int s_len, int l_len, string s, string l){
        vector<int> freq(s_len,0); 
        for(int i = 0; i<s_len; i++){
            if(l.find(s[i]) != string::npos){
                freq[i] = 1;
            }
            else{
                freq[i] = 0;
            }
        }
        int answer = longest(freq);
        return answer;
    }
    int longest(vector<int> freq){
        int n = freq.size();
        int maxi = 1, cnt = 1;
        for(int i = 1; i<n; i++){
            if(freq[i] == freq[i-1]){
                cnt++;
                // maxi = max(maxi, cnt);
            }
            else{
                cnt = 1;
            }
                maxi = max(maxi, cnt);
        }
        return maxi;
    }
};

int main() {
	// your code goes here
	Anikesh obj;
    return 0;
}
