#include <bits/stdc++.h>
using namespace std;

class Anikesh{
  public:
  Anikesh(){
      output();
  }
  private:
  void output(){
          int x, k, y;
          cin>>x>>k>>y;
          cout << (isPossible(x,k,y) ? "Yes" : "No") << endl;
  }
  bool isPossible(int x, int k, int y){
    //   vector<int> vec(x);
    //   for(int i = 1; i<=x; i++){
    //       vec[i] = vec.push_back(x*i);
    //   }
    unordered_map<int,int> mpp;
    for(int i = 1; i<= x; i++){
        mpp.insert({i*k, i});
    }
    if(mpp.find(y)!= mpp.end()) return true;
    return false;
  }
};

int main() {
	// your code goes here
	Anikesh obj;

}
