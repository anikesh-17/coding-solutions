#include <iostream>
#include <map>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    cout.tie(NULL);
    int t, n, i, db;
    cin >> t;
    while (t--) {
        db = 1;
        cin >> n;
        int a[n];
        map < int, int > mp;
        for (i = 0; i < n; i++) {
            cin >> a[i];
            mp[a[i]]++;
        }
        for (i = n - 1; i >= 0; i--) {
            if (mp[a[i]] % 2) {
                cout << "Marichka";
                db = 0;
                break;
            }
        }
        if (db) {
            cout << "Zenyk";
        }
        /*	    cout<<max<<" "<<c;
        	    if(n==1){
        	        cout<<"Marichka";
        	    }
        	    else{
        	        if(c%2==1){
        	            cout<<"Marichka";
        	        }
        	        else{
        	            cout<<"Zenyk";
        	        }
        	    } */
        cout << "\n";
    }
    return 0;
}