#include <bits/stdc++.h>
using namespace std;
#define ll long long

class Anikesh{
public:
    Anikesh(){
        output();
    }
private:
    ll distance(ll row1, ll col1, ll row2, ll col2){
        return max(abs(row1 - row2), abs(col2 - col1));
    }
    void output(){
        int t;
        cin>>t;
        while(t--){
            ll n,m,row,col;
            cin>>n>>m;
            cin>>row>>col;
            cout << min_moves(n,m,row,col) << endl;
        }
    }
    int min_moves(ll n, ll m, ll row, ll col){
        vector<pair<ll, ll>> vertices = {
            {1,1},
            {1,m},
            {n,1},
            {n,m}
        };
        vector<int> pos = {0,1,2,3};
        ll answer = LLONG_MAX;
        do{
            ll total = 0;
            ll ar = row;
            ll aa = col;
            for(int i = 0; i<4; i++){
                ll br = vertices[pos[i]].first;
                ll bc = vertices[pos[i]].second;
                total += distance(ar,aa,br,bc);
                ar = br;
                aa = bc;
            }
            answer = min(answer, total);
        }
        while(std::next_permutation(pos.begin(), pos.end()));
        return answer;
    }
};

int main() {
	// your code goes here
	Anikesh obj;
	return 0;
}
