#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<long long> B(N);

        for (int i = 0; i < N; i++) {
            long long x;
            cin >> x;

            // Transform alternating operations into normal
            // +1/-1 subarray operations.
            if (i % 2 == 0)
                B[i] = x;
            else
                B[i] = -x;
        }

        long long ans = abs(B[0]) + abs(B[N - 1]);

        for (int i = 1; i < N; i++) {
            ans += abs(B[i] - B[i - 1]);
        }

        cout << ans / 2 << '\n';
    }

    return 0;
}
