#include <bits/stdc++.h>
using namespace std;

class Anikesh{
public:
    Anikesh(){
        output();
    }
private:
    void output(){
        int t;
        cin>>t;
        while(t--){
            int n, k;
            cin>>n>>k;
            vector<int> vec(n);
            for (int i = 0; i < n; i++) {
                cin>>vec[i];
            }
            cout << maxWaterContain(vec, n, k) << endl;
        }
    }
    int maxWaterContain(vector<int> vec, int n, int k){
        sort(vec.begin(), vec.end());
        int totalWater = vec[n-1];
        // if(n > k){
        //     totalWater = accumulate(vec.begin(), vec.end(), 0);
        //     return totalWater;
        // }
        // int i = 2;
        // while(k > 0){
        //     sort(vec.begin(), vec.end());
        //     totalWater += vec[n-i];
        //     i++;
        //     k--;
        // }
        int i = 2;
        while (i <= n && i <= k+1) {
            totalWater += vec[n-i];
            i++;
        }
        return totalWater;
    }
};

int main() {
	// your code goes here
	Anikesh obj;
}
