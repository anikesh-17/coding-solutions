#include <bits/stdc++.h>
using namespace std;

class Anikesh{
  public:
  void testCase(){
      int t;
      cin>>t;
      while(t--){
          int n;
          cin>>n;
          int len, bre;
          cin>>len >> bre;
          cout << (possible(len, bre) ? "Yes" : "No") << endl;
      }
  }
  private:
  bool possible(int len, int bre){
      int area = len * bre;
      return area % 2 == 0;
  }
};

int main() {
	// your code goes here
	Anikesh obj;
	obj.testCase();

}
