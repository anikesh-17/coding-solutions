#include <bits/stdc++.h>
using namespace std;

class Anikesh{
public:
    Anikesh(){
        output();
    }
private:
    void output(){
        int t;
        cin>>t;
        while(t--){
            int n;
            cin>>n;
            vector<int> a(n), b(n);
            for(int i = 0; i<n; i++){
                cin >> a[i];
            }
            for(int i = 0; i<n; i++){
                cin >> b[i];
            }
            cout << (isPossible(a, b, n) ? "Yes" : "No") << endl;
        }
    }
    bool isPossible(vector<int>& a, vector<int>& b, int n){
        int sumA = std::accumulate(a.begin(), a.end(), 0);
        int sumB = std::accumulate(b.begin(), b.end(), 0);
        return sumA == sumB;
    }
};

int main() {
	// your code goes here
	Anikesh obj;
	return 0;

}
