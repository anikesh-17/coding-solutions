#include <bits/stdc++.h>
using namespace std;

class Anikesh{
  public:
  Anikesh(){
      output();
  }
  private:
  void output(){
      int t;
      cin>>t;
      while(t--){
          int n;
          cin>>n;
          vector<int> vec(n);
          for (int i = 0; i < n; i++) {
              cin>>vec[i];
          }
          cout << chk(vec, n) << endl;
      }
  }
  int chk(vector<int> vec, int n){
    int bge = 0;
    for (int i = 0; i < n; i++) {
        int less = 0;
        for(int j = 0; j<n; j++){
            if(vec[j] <= vec[i]) less++;
        }
        int high = n - less;
        if(less > high) bge++;
    }
    return bge;
  }
};

int main() {
	// your code goes here
	Anikesh obj;

}
