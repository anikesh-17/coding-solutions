#include <bits/stdc++.h>
using namespace std;

class Anikesh{
  public:
  Anikesh(){
      output();
  }
  private:
  void output(){
      int t;
      cin>>t;
      while(t--){
          int n;
          cin>>n;
          vector<int> vec(n);
          for (int i = 0; i < n; i++) {
              cin>>vec[i];
          }
          cout << chk(vec, n) << endl;
      }
  }
  int chk(vector<int> vec, int n){
    //   sort(vec.begin(), vec.end());
    //   for(int i = n-1; i>=0; i--){
             
    //   }
    int maxi = *std::max_element(vec.begin(), vec.end());
    int cnt = 0;
    for (int i = 0; i < n; i++) {
        if(vec[i] == maxi) cnt++;
    }
    return cnt;
  }
};

int main() {
	// your code goes here
	Anikesh obj;

}
