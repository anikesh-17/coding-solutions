#include <bits/stdc++.h>
using namespace std;

class Anikesh{
public:
    Anikesh(){
        output();
    }
private:
    void output(){
        int t;
        cin>>t;
        while(t--){
            int n,k;
            cin>>n>>k;
            cout << (steps(n,k) ? "Yes" : "No") << endl;
        }
    }
    bool steps(int n, int k){
        return ((n >= k) && (n <= 2*k));
    }
};

int main() {
	// your code goes here
	Anikesh obj;
}
