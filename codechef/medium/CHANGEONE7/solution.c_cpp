#include <bits/stdc++.h>
using namespace std;

class Anikesh{
public:
    Anikesh(){
        output();
    }
private:
    void output(){
        int t;
        cin >> t;
        while(t--){
            int n;
            cin>>n;
            vector<int> vec(n);
            for(int i = 0; i < n; i++){
                cin>>vec[i];
            }
            cout << changes(n, vec) << endl;
        }
    }
    int changes(int n, vector<int> vec){
        sort(vec.begin(), vec.end());
        return min((vec[n-1] - vec[1]), (vec[n-2] - vec[0]));
    }
};

int main() {
	// your code goes here
	Anikesh obj;

}
