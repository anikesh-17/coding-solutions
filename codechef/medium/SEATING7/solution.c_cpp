#include <bits/stdc++.h>
using namespace std;

class Anikesh {
    public: 
    void testCase() {
        int t;
        cin >> t;
        while (t--) {
            int n,m,k;
            cin>>n>>m>>k;
            vector<int> vec(n);
            for(int i = 0; i<m; i++){
                cin >> vec[i];
            }
            vector<int> ans = vacant(n,m,k, vec);
            for(auto it : ans){
                cout << it << " ";
            }
            cout << endl;
        }
    }
    private:
    vector<int> vacant(int n, int m, int k, vector<int> occSeat){
        vector<bool> toOccupy(n+1,false);
        vector<int> ans;
        for(int i : occSeat){
            toOccupy[i] = true;
        }
        for(int i = 1; i<=n && k > 0; i++){
            if(toOccupy[i] == false){
                toOccupy[i] = true;
                ans.push_back(i);
                k--;
            }
        }
        return ans;
    }
};


int main() {
    // your code goes here
    Anikesh obj;
    obj.testCase();
}